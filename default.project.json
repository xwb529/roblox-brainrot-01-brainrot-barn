{
  "name": "Brainrot Barn",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "Shared": { "$path": "src/shared" } },
    "ServerScriptService": { "Server": { "$path": "src/server" } },
    "StarterPlayer": {
      "$properties": { "CharacterWalkSpeed": 18, "CameraMaxZoomDistance": 90, "CameraMinZoomDistance": 8 },
      "StarterPlayerScripts": { "Client": { "$path": "src/client" } }
    },
    "Workspace": { "$properties": { "FilteringEnabled": true, "Gravity": 196.2 } },
    "Lighting": {
      "$properties": {
        "Ambient": [0.55, 0.55, 0.65], "OutdoorAmbient": [0.65, 0.65, 0.7],
        "Brightness": 2.5, "ClockTime": 14, "GlobalShadows": true
      },
      "WarmDay": { "$className": "ColorCorrectionEffect", "$properties": {
        "Saturation": 0.12, "Contrast": 0.06, "TintColor": [1, 0.98, 0.94]
      } }
    },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
